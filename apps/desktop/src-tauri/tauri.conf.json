{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nudgy",
  "version": "0.1.0",
  "identifier": "com.nudgy.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nudgy",
        "width": 880,
        "height": 720,
        "minWidth": 600,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nudgy",
    "shortDescription": "A sleepy armored panda that keeps you focused",
    "resources": {
      "../../../data/models/all-MiniLM-L6-v2/": "models/all-MiniLM-L6-v2/",
      "../../extension/dist/": "extension/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
