{
  "name": "@nudgy/proxy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloudflare Worker that writes short personalised panda lines, quota-limited per device.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@nudgy/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.3"
  }
}
